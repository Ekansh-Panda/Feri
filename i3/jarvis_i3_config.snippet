# ============================================
# JARVIS NEXUS — i3wm Integration
# ============================================

# JARVIS HUD assignment
assign [title="J.A.R.V.I.S.*"] 10

# JARVIS window rules
for_window [title="J.A.R.V.I.S.*"] floating enable
for_window [title="J.A.R.V.I.S.*"] border pixel 0
for_window [title="J.A.R.V.I.S.*"] resize set 1400 800
for_window [title="J.A.R.V.I.S.*"] move position center
