#!/bin/bash
# feri — launch JARVIS NEXUS

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

cd "$PROJECT_DIR" || exit 1

# Check if already running
if pgrep -f "python3 main.py" > /dev/null 2>&1; then
    if [ "$1" = "--toggle" ]; then
        i3-msg '[title="J.A.R.V.I.S.*"] scratchpad show' 2>/dev/null
    fi
    echo "JARVIS is already running, sir."
    exit 0
fi

echo "Starting JARVIS NEXUS from $PROJECT_DIR..."

# Run in background, capture output
nohup python3 main.py > /tmp/jarvis.log 2>&1 &
JARVIS_PID=$!

sleep 4

if kill -0 $JARVIS_PID 2>/dev/null; then
    echo "JARVIS online. PID: $JARVIS_PID"
    echo "Logs: /tmp/jarvis.log"
else
    echo "Failed to start JARVIS. Showing last 40 lines of /tmp/jarvis.log:"
    echo "---"
    tail -n 40 /tmp/jarvis.log 2>/dev/null || echo "(no log file)"
    echo "---"
    exit 1
fi
