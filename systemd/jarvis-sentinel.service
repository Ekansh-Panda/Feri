[Unit]
Description=JARVIS Sentinel Watchdog
After=graphical.target

[Service]
Type=simple
User=%i
Environment=DISPLAY=:0
Environment=XAUTHORITY=/run/user/%U/.Xauthority
Environment=XDG_RUNTIME_DIR=/run/user/%U
WorkingDirectory=%h/Mark-LII
ExecStart=/usr/bin/python3 -c "
import os, sys, time, subprocess
sys.path.insert(0, os.path.expanduser('~/Mark-LII'))
while True:
    if not subprocess.run(['pgrep', '-f', 'python3 main.py'],
                          capture_output=True).stdout:
        subprocess.Popen(['feri', 'start'])
    time.sleep(30)
"
Restart=on-failure
RestartSec=15

[Install]
WantedBy=graphical.target
